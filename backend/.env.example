# ==========================================
# ExpenseVision Backend Environment Variables (.env.example)
# ==========================================

DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Open Models (Cloud: https://ollama.com or Local: http://localhost:11434)
# For Ollama Cloud, create an API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b

# Google OAuth 2.0 Client ID (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

